# Discord Status Bot - Environment Configuration Example
#
# This file shows the environment variables and Cloudflare secrets needed
# to run the Discord Status Bot. Copy this to your wrangler.toml and 
# configure the actual values.
#
# ============================================================================
# SECRETS (Sensitive data - use `wrangler secret put` command)
# ============================================================================

# Discord Application Credentials
# Get these from: https://discord.com/developers/applications
# DISCORD_APPLICATION_ID=your_discord_application_id_here
# DISCORD_BOT_TOKEN=your_discord_bot_token_here
# DISCORD_PUBLIC_KEY=your_discord_public_key_here

# LLM API Credentials (format: provider:api_key)
# Supported providers: anthropic, openai, openrouter
# Examples:
# LLM_CREDENTIALS=anthropic:sk-ant-api03-xxxxx
# LLM_CREDENTIALS=openai:sk-xxxxx
# LLM_CREDENTIALS=openrouter:sk-or-xxxxx

# ============================================================================
# ENVIRONMENT VARIABLES (Public configuration - put in [vars] section)
# ============================================================================

# Environment setting
ENVIRONMENT=development

# Discord Configuration
DISCORD_API_VERSION=v10
STATUS_CHANNEL_ID=your_discord_channel_id_here

# LLM Configuration (optional overrides)
# LLM_MODEL=claude-3-haiku-20240307
# LLM_MAX_TOKENS=1000
# LLM_TEMPERATURE=0.1

# Optional: Override default API endpoints (for custom deployments)
# LLM_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
# LLM_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions  
# LLM_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# ============================================================================
# CLOUDFLARE WORKERS CONFIGURATION
# ============================================================================

# Your wrangler.toml should look like this:
#
# name = "discord-status-bot"
# compatibility_date = "2024-01-01"
# main = "src/index.js"
#
# [vars]
# ENVIRONMENT = "production"
# DISCORD_API_VERSION = "v10"
# STATUS_CHANNEL_ID = "1234567890123456789"
# LLM_MODEL = "claude-3-haiku-20240307"
# LLM_MAX_TOKENS = "1000"
# LLM_TEMPERATURE = "0.1"
# LLM_ANTHROPIC_ENDPOINT = "https://api.anthropic.com/v1/messages"
# LLM_OPENAI_ENDPOINT = "https://api.openai.com/v1/chat/completions"
# LLM_OPENROUTER_ENDPOINT = "https://openrouter.ai/api/v1/chat/completions"
#
# [[kv_namespaces]]
# binding = "STATUS_BOT_STORAGE"
# id = "your_kv_namespace_id_here"
# preview_id = "your_preview_kv_namespace_id_here"

# ============================================================================
# REQUIRED SETUP STEPS
# ============================================================================

# 1. Create Discord Application:
#    - Go to https://discord.com/developers/applications
#    - Create new application
#    - Get Application ID and Public Key
#    - Go to Bot section, create bot and get Bot Token

# 2. Create KV Namespace:
#    wrangler kv:namespace create "STATUS_BOT_STORAGE"
#    wrangler kv:namespace create "STATUS_BOT_STORAGE" --preview

# 3. Set Cloudflare Secrets:
#    wrangler secret put DISCORD_APPLICATION_ID
#    wrangler secret put DISCORD_BOT_TOKEN
#    wrangler secret put DISCORD_PUBLIC_KEY
#    wrangler secret put LLM_CREDENTIALS

# 4. Deploy:
#    wrangler deploy

# 5. Register Discord Commands:
#    curl -X PUT \
#      "https://discord.com/api/v10/applications/{APPLICATION_ID}/commands" \
#      -H "Authorization: Bot {BOT_TOKEN}" \
#      -H "Content-Type: application/json" \
#      -d @commands.json

# ============================================================================
# OPTIONAL CONFIGURATIONS
# ============================================================================

# Multiple Environments
# For staging/production deployments, create separate wrangler.toml files:
# - wrangler.staging.toml
# - wrangler.production.toml
# 
# Deploy with: wrangler deploy --config wrangler.staging.toml

# Custom Domain (optional)
# Add to wrangler.toml:
# [env.production]
# routes = [{ pattern = "discord-bot.yourdomain.com/*", zone_name = "yourdomain.com" }]

# ============================================================================
# SECURITY NOTES
# ============================================================================

# - Never commit actual secrets to version control
# - Use different Discord applications for dev/staging/production
# - Rotate API keys regularly
# - Monitor usage and costs through Cloudflare dashboard
# - Set up alerts for unusual activity

# ============================================================================
# TROUBLESHOOTING
# ============================================================================

# Common issues:
# 1. "Invalid interaction token" - Check DISCORD_PUBLIC_KEY matches your app
# 2. "Missing Access" - Ensure bot has proper permissions in Discord server
# 3. "KV binding not found" - Verify kv_namespaces binding name matches config
# 4. "LLM API errors" - Check LLM_CREDENTIALS format and API key validity
# 5. "Commands not appearing" - Re-register slash commands with Discord API