{
  "name": "discord-status-bot",
  "version": "2025.08.21",
  "description": "AI-powered Discord status bot running on Cloudflare Workers",
  "author": "Robert Sigler <code@sigler.io>",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:prod": "wrangler deploy --env production",
    "tail": "wrangler tail",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "register:commands": "node register.js",
    "verify:commands": "node scripts/verify-commands.js",
    "commands": "npm run verify:commands && npm run register:commands",
    "backup:kv": "node scripts/backup-kv.js",
    "restore:kv": "node scripts/restore-kv.js",
    "migrate:kv": "node scripts/migrate-kv.js",
    "validate": "npm run lint && npm run format:check",
    "precommit": "npm run validate && npm run test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.3.1",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "vitest": "^1.3.1",
    "wrangler": "^4.32.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
